# Database
DATABASE_URI=mongodb://127.0.0.1/neet

# Payload
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx

# Turnstile (Cloudflare CAPTCHA alternative)
# Get your keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x5AAAAAAA...

# API key for n8n automated blog publishing (used by POST /api/publish-blog)
PUBLISH_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Optional: Node environment
NODE_ENV=development
